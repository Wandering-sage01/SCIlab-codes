clc; clear;

h=1973; m=0.511e6; e=3.795;
K=h^2/(2*m); N=400; R=30;
dr=R/(N+1); r=(1:N)'*dr;

V=-e^2./r;

H=diag(2*K/dr^2+V)+...
  diag(-K/dr^2*ones(N-1,1),1)+...
  diag(-K/dr^2*ones(N-1,1),-1);

[U,D]=spec(H);
[E,I]=gsort(diag(D),"g","i");

u1=U(:,I(1)); u2=U(:,I(2));

u1=u1/sqrt(sum(u1.^2)*dr);
u2=u2/sqrt(sum(u2.^2)*dr);

if u1(1)<0 then u1=-u1; end
if u2(1)<0 then u2=-u2; end

mprintf("Ground state = %.3f eV\n",E(1));
mprintf("First excited = %.3f eV\n",E(2));

clf();
plot(r,u1,"r");
plot(r,u2,"b");

xlabel("r (Angstrom)");
ylabel("u(r)");
title("Hydrogen Atom");
legend("Ground state","First excited state");
